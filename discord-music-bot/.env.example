DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id
# Optional but recommended for instant command updates in one server:
DISCORD_GUILD_ID=your_guild_id
# Required to use /setup-panel and force panel in one channel:
MUSIC_PANEL_CHANNEL_ID=your_text_channel_id
DEFAULT_VOLUME=0.6
